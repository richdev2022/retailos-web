# API base URL (without trailing slash). Used by the axios client.
# In dev the Vite proxy forwards /api -> this target automatically.
VITE_API_URL=http://localhost:4000

# Use in-memory mock data instead of calling the backend.
# When true, the API client returns realistic mock responses so the app
# demos out-of-the-box without a running backend.
VITE_USE_MOCK=false

# Optional: app name shown in the UI
VITE_APP_NAME=RetailOS
